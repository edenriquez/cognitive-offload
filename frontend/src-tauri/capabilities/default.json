{
  "identifier": "default",
  "description": "Cogload default capability",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "shell:allow-open",
    "updater:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "binaries/cogload-backend",
          "sidecar": true,
          "args": true
        }
      ]
    }
  ]
}
